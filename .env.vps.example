# Set the real HTTPS origin before production. No path or trailing slash.
PUBLIC_ORIGIN=https://an.example.com
FIREBASE_PROJECT_ID=your-firebase-project-id
# Verified Google emails only; comma separated. Do not commit .env.vps.
ADMIN_EMAILS=
MODERATOR_EMAILS=
# Only the exact Docker gateway for the loopback-only published port.
# The host Nginx must overwrite X-Real-IP with $remote_addr.
TRUSTED_PROXY_IPS=172.29.0.1

# PostgreSQL URL, URI-encode special characters in credentials.
DATABASE_URL=postgresql://hnag:CHANGE_ME@127.0.0.1:5432/hnag
PG_POOL_MAX=10
POSTGRES_PASSWORD=REDACTED
