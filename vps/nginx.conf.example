# Include in the http context; replace the host and certificate paths.
limit_req_zone $binary_remote_addr zone=hnag_requests:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=hnag_conn:10m;
server {
    listen 80;
    server_name an.example.com;
    return 308 https://an.example.com$request_uri;
}
server {
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/an.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/an.example.com/privkey.pem;
    server_name an.example.com;
    client_max_body_size 4m;
    limit_req_status 429;
    limit_conn_status 429;
    limit_conn hnag_conn 40;
    location / {
        limit_req zone=hnag_requests burst=60 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
