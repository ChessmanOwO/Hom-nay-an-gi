# Local PC only. Use a separate HTTPS configuration for production.
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
APP_HOST=127.0.0.1
APP_PORT=3000
DATA_DIR=vps/data
FIREBASE_PROJECT_ID=your-firebase-project-id
# Comma-separated list of admin Google emails
ADMIN_EMAILS="admin@example.com,moderator@example.com"
MODERATOR_EMAILS=
TRUSTED_PROXY_IPS=

# PostgreSQL URL, URI-encode special characters in credentials.
DATABASE_URL=postgresql://hnag:CHANGE_ME@127.0.0.1:5432/hnag
PG_POOL_MAX=10
